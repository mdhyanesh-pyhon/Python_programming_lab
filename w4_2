n = int(input("Enter a number: "))
even_count = 0
odd_count = 0
for i in range(1,n+1):
    if i%2 == 0:
        print(f"{i} is even")
        even_count+=1
    else:
        print(f"{i} is odd")
        odd_count+=1
print(f"Total number of even numbers are {even_count}")
print(f"Total number of odd numbers are {odd_count}")
